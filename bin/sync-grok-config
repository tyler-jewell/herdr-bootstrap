#!/usr/bin/env python3
"""Sync herdr-bootstrap .grok/config.yaml → ~/.grok/config.yaml + ~/.grok/config.toml.

Source of truth is the project file. Local Grok global config is fully replaced
for the keys we generate (cli, marketplace, ui, features). Other unknown keys
are not preserved — this is intentional "override entire local config" for the
managed sections.
"""

from __future__ import annotations

import os
import shutil
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
SRC_YAML = REPO / ".grok" / "config.yaml"
SRC_LSP = REPO / ".grok" / "lsp.json"
USER_GROK = Path(os.environ.get("GROK_HOME", Path.home() / ".grok"))
DST_YAML = USER_GROK / "config.yaml"
DST_TOML = USER_GROK / "config.toml"
DST_LSP = USER_GROK / "lsp.json"  # optional convenience copy; project file still wins in-repo


def die(msg: str) -> None:
    print(f"XX  {msg}", file=sys.stderr)
    sys.exit(1)


def parse_simple_yaml(text: str) -> dict:
    """Minimal YAML subset: maps, lists of maps, bool/int/str. No anchors."""
    root: dict = {}
    stack: list = [root]  # dict or list currently open
    indents: list = [-1]
    # For list items that are maps, track indent of list key's children
    list_map_stack: list = []  # (list_obj, item_dict, indent)

    def current_dict():
        cur = stack[-1]
        if isinstance(cur, dict):
            return cur
        # if we're in a list of maps, last item
        if isinstance(cur, list) and cur and isinstance(cur[-1], dict):
            return cur[-1]
        return None

    for raw in text.splitlines():
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        # strip inline comments carefully
        line = raw
        if " #" in line:
            # naive: only if not in quotes
            in_q = False
            out = []
            i = 0
            while i < len(line):
                c = line[i]
                if c in "\"'":
                    in_q = not in_q
                if not in_q and line[i : i + 2] == " #":
                    break
                out.append(c)
                i += 1
            line = "".join(out).rstrip()

        indent = len(line) - len(line.lstrip(" "))
        content = line.strip()

        # pop stack for indent
        while len(indents) > 1 and indent <= indents[-1]:
            stack.pop()
            indents.pop()

        if content.startswith("- "):
            item = content[2:].strip()
            # find parent list
            parent = stack[-1]
            if not isinstance(parent, list):
                # shouldn't happen if structure is correct
                die(f"list item without list parent: {content}")
            if ":" in item and not item.startswith("{"):
                # map item: key: val or key:
                k, _, v = item.partition(":")
                k = k.strip()
                v = v.strip()
                d = {}
                if v == "":
                    parent.append(d)
                    stack.append(d)
                    indents.append(indent)
                else:
                    d[k] = parse_val(v)
                    parent.append(d)
            else:
                parent.append(parse_val(item))
            continue

        if ":" in content:
            k, _, v = content.partition(":")
            k = k.strip()
            v = v.strip()
            d = current_dict()
            if d is None:
                die(f"no dict for key {k}")
            if v == "":
                # nested map or list comes next — peek not available; create map, list if next is -
                # We'll create a dict; if next lines are list items at greater indent under wrong type,
                # fix by: store placeholder and convert on first list item
                child: dict = {}
                d[k] = child
                stack.append(child)
                indents.append(indent)
            else:
                d[k] = parse_val(v)
            continue

        die(f"unparsed line: {raw!r}")

    # Convert empty dicts that should have been lists: marketplace.sources is list
    # Our parser creates dict for `sources:` then fails on list items if parent is dict.
    # Fix: when we see list item and parent is empty dict, replace with list in grandparent.
    return root


def parse_simple_yaml_v2(text: str) -> dict:
    """Line-based YAML for our fixed schema (maps + list of maps under marketplace.sources)."""
    data: dict = {}
    section = None  # top-level key
    sub = None  # nested under section
    sources = None
    source_item = None

    for raw in text.splitlines():
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        line = raw.split(" #")[0].rstrip() if " #" in raw and not raw.strip().startswith("#") else raw.rstrip()
        # better strip comments
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        # remove trailing comments outside quotes
        stripped = line.strip()
        indent = len(line) - len(line.lstrip(" "))

        if indent == 0 and stripped.endswith(":") and not stripped.startswith("-"):
            key = stripped[:-1].strip()
            section = key
            sub = None
            source_item = None
            if key == "marketplace":
                data.setdefault("marketplace", {})
            elif key == "cli":
                data.setdefault("cli", {})
            elif key == "ui":
                data.setdefault("ui", {})
            elif key == "features":
                data.setdefault("features", {})
            else:
                data.setdefault(key, {})
            continue

        if section is None:
            continue

        # list under marketplace.sources
        if stripped.startswith("- ") and section == "marketplace":
            item_body = stripped[2:].strip()
            data.setdefault("marketplace", {}).setdefault("sources", [])
            sources = data["marketplace"]["sources"]
            if ":" in item_body:
                k, _, v = item_body.partition(":")
                source_item = {k.strip(): parse_val(v.strip())}
                sources.append(source_item)
            else:
                source_item = {}
                sources.append(source_item)
            continue

        if indent >= 4 and source_item is not None and ":" in stripped and not stripped.startswith("-"):
            k, _, v = stripped.partition(":")
            source_item[k.strip()] = parse_val(v.strip())
            continue

        if indent >= 2 and ":" in stripped and not stripped.startswith("-"):
            k, _, v = stripped.partition(":")
            k, v = k.strip(), v.strip()
            if v == "" and k == "sources":
                data.setdefault("marketplace", {})["sources"] = []
                source_item = None
                continue
            target = data.setdefault(section, {})
            if not isinstance(target, dict):
                continue
            target[k] = parse_val(v)
            continue

    return data


def parse_val(v: str):
    v = v.strip()
    if (v.startswith('"') and v.endswith('"')) or (v.startswith("'") and v.endswith("'")):
        return v[1:-1]
    if v in ("true", "false"):
        return v == "true"
    try:
        return int(v)
    except ValueError:
        pass
    return v


def toml_escape(s: str) -> str:
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def emit_toml(data: dict) -> str:
    lines: list[str] = []
    lines.append("# Generated by herdr-bootstrap bin/sync-grok-config from .grok/config.yaml")
    lines.append("# Do not hand-edit for team settings — edit the repo config.yaml and re-sync.")
    lines.append("")

    if "cli" in data:
        lines.append("[cli]")
        for k, v in data["cli"].items():
            lines.append(f"{k} = {fmt_toml_val(v)}")
        lines.append("")

    if "marketplace" in data:
        m = data["marketplace"]
        lines.append("[marketplace]")
        for k, v in m.items():
            if k == "sources":
                continue
            lines.append(f"{k} = {fmt_toml_val(v)}")
        lines.append("")
        for src in m.get("sources") or []:
            lines.append("[[marketplace.sources]]")
            for k, v in src.items():
                lines.append(f"{k} = {fmt_toml_val(v)}")
            lines.append("")

    if "ui" in data:
        lines.append("[ui]")
        for k, v in data["ui"].items():
            lines.append(f"{k} = {fmt_toml_val(v)}")
        lines.append("")

    if "features" in data:
        lines.append("[features]")
        for k, v in data["features"].items():
            lines.append(f"{k} = {fmt_toml_val(v)}")
        lines.append("")

    return "\n".join(lines).rstrip() + "\n"


def fmt_toml_val(v) -> str:
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, int) and not isinstance(v, bool):
        return str(v)
    return toml_escape(str(v))


def main() -> int:
    dry = "--dry-run" in sys.argv
    if not SRC_YAML.is_file():
        die(f"missing {SRC_YAML}")

    text = SRC_YAML.read_text(encoding="utf-8")
    data = parse_simple_yaml_v2(text)
    if not data:
        die("parsed empty config from config.yaml")

    toml_body = emit_toml(data)
    USER_GROK.mkdir(parents=True, exist_ok=True)

    print(f"==> source  {SRC_YAML}")
    print(f"==> write   {DST_YAML}")
    print(f"==> write   {DST_TOML}")
    if dry:
        print("--- toml preview ---")
        print(toml_body)
        return 0

    # backup existing toml once per run
    if DST_TOML.is_file():
        bak = DST_TOML.with_suffix(".toml.pre-herdr-bootstrap")
        if not bak.exists():
            shutil.copy2(DST_TOML, bak)
            print(f"==> backup  {bak}")

    shutil.copy2(SRC_YAML, DST_YAML)
    DST_TOML.write_text(toml_body, encoding="utf-8")

    # Optional: also publish project lsp.json to user home so tools outside repo see rust-analyzer
    # Project .grok/lsp.json still wins when working inside the repo.
    if SRC_LSP.is_file():
        shutil.copy2(SRC_LSP, DST_LSP)
        print(f"==> write   {DST_LSP} (from project lsp.json)")

    print("OK  local Grok config overridden from project .grok/config.yaml")
    print("    Restart Grok sessions to pick up ~/.grok/config.toml")
    return 0


if __name__ == "__main__":
    sys.exit(main())
