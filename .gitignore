.DS_Store
*.log
.env
.env.*
auth.json
*.pem
node_modules/

# Plugins and agent skills live only in tyler-jewell/herdr-plugins (never here).
/plugins/
/skills/

# Track team Grok harness surfaces (dotfiles shape → ~/.grok/); ignore the rest
.grok/*
!.grok/config.yaml
!.grok/config.toml
!.grok/lsp.json
!.grok/README.md
!.grok/rules/
!.grok/rules/**
!.grok/hooks/
!.grok/hooks/**
# Herdr integration overwrites these; never version (see agent-rule-quality.md).
.grok/hooks/herdr.json
.grok/hooks/herdr-agent-state.sh
!.grok/agents/
!.grok/agents/**
!.grok/personas/
!.grok/personas/**
