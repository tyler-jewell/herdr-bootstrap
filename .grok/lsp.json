{
  "rust": {
    "command": "rust-analyzer",
    "args": [],
    "extensionToLanguage": {
      ".rs": "rust"
    },
    "startupTimeout": 60000,
    "restartOnCrash": true,
    "maxRestarts": 3
  },
  "go": {
    "command": "gopls",
    "args": ["serve"],
    "extensionToLanguage": {
      ".go": "go",
      ".mod": "go.mod",
      ".sum": "go.sum",
      ".work": "go.work"
    },
    "startupTimeout": 60000,
    "restartOnCrash": true,
    "maxRestarts": 3
  },
  "lua": {
    "command": "lua-language-server",
    "args": [],
    "extensionToLanguage": {
      ".lua": "lua"
    },
    "startupTimeout": 60000,
    "restartOnCrash": true,
    "maxRestarts": 3
  }
}
